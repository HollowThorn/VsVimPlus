<vsui:DialogWindow x:Class="Vim.VisualStudio.RecentFiles.RecentFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="600"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="SelectionBrush" Color="#094F8C" />
        <Style x:Key="RecentFileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="ChromeBorder" CornerRadius="4" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="SearchBoxBorder"
                    Grid.Row="0"
                    Margin="10"
                    CornerRadius="3"
                    BorderThickness="1">
                <TextBox x:Name="SearchBox"
                         Padding="6,5"
                         FontSize="14"
                         BorderThickness="0"
                         Background="Transparent"
                         TextChanged="OnSearchTextChanged" />
            </Border>
            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     MaxHeight="360"
                     Margin="0,0,0,8"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemContainerStyle="{StaticResource RecentFileItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="OnResultsListMouseUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Margin="10,4">
                            <TextBlock Text="{Binding FileName}" FontSize="13" />
                            <TextBlock Text="{Binding DirectoryPath}" FontSize="11" Opacity="0.65" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyHint"
                       Grid.Row="1"
                       Margin="10,4,10,16"
                       FontSize="12"
                       Opacity="0.65"
                       Text="No recent files yet"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</vsui:DialogWindow>
